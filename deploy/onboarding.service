# Pi Onboarding Console — systemd *user* unit.
#
# Runs as a user unit (not a system unit) so the process inherits your session
# bus, which is what `rpi-connect` talks to. It runs as your login user; the
# only privileged bits are the Wi-Fi commands in deploy/sudoers.d/pi-console.
#
# Uses the system python3 (deps installed system-wide, no venv). Install them with:
#   sudo apt install -y python3-fastapi python3-uvicorn python3-jinja2 python3-picamera2
#
# Install the unit:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/onboarding.service ~/.config/systemd/user/onboarding.service
#   # adjust WorkingDirectory below if the checkout isn't ~/storeyes-onboarding
#   systemctl --user daemon-reload
#   systemctl --user enable --now onboarding
#
#   # keep it running when you're not logged in (also needed for boot start):
#   sudo loginctl enable-linger "$USER"
#
# Manage:
#   systemctl --user status onboarding
#   systemctl --user restart onboarding
#   journalctl --user -u onboarding -f

[Unit]
Description=Pi Onboarding Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/storeyes-onboarding
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
