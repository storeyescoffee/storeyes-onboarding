# Pi Onboarding Console — systemd *user* unit.
#
# Running as a user unit (not a system unit) gives the process the user's
# session bus, which is what `rpi-connect` needs.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/pi-console.service ~/.config/systemd/user/pi-console.service
#   # edit WorkingDirectory / ExecStart below if the checkout isn't ~/storeyes-onboarding
#   systemctl --user daemon-reload
#   systemctl --user enable --now pi-console
#
#   # so it keeps running when you're not logged in:
#   sudo loginctl enable-linger "$USER"

[Unit]
Description=Pi Onboarding Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/storeyes-onboarding
ExecStart=%h/storeyes-onboarding/.venv/bin/python main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
